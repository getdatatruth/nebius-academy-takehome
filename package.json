{
  "name": "nebius-academy-inbound-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Track A take-home: inbound lead engine with a benchmark intelligence layer, for Nebius Academy",
  "scripts": {
    "build": "node build/build-workflow.mjs",
